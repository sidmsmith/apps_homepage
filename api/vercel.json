{
  "version": 2,
  "builds": [
    {
      "src": "index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/index.py"
    },
    {
      "src": "/manhlogo.png",
      "dest": "/manhlogo.png"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}

